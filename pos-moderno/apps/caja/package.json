{
  "name": "@pos/caja",
  "version": "0.1.0",
  "private": true,
  "description": "App de caja (POS) — Electron + React. Hardware local y operación offline.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist:win": "npm run build && electron-builder --win nsis",
    "lint": "echo \"(sin lint aún)\""
  },
  "build": {
    "appId": "com.pse.caja",
    "productName": "PSE Caja",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "npmRebuild": true,
    "files": [
      "out/**/*",
      "package.json",
      "!src",
      "!build-api",
      "!release",
      "!electron.vite.config.*",
      "!tsconfig*.json"
    ],
    "extraResources": [
      {
        "from": "build-api",
        "to": "api"
      },
      {
        "from": "../../../script.sql",
        "to": "db/script.sql"
      },
      {
        "from": "../../db/appconfig.sql",
        "to": "db/appconfig.sql"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "PSE-Caja-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "PSE Caja",
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "@pos/types": "*",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "better-sqlite3": "^11.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.56.0",
    "mssql": "^11.0.2",
    "recharts": "^2.12.7",
    "serialport": "^12.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/mssql": "^12.3.0",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "31.7.7",
    "electron-vite": "^2.3.0",
    "electron-builder": "^26.0.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}